{
    "testRunner": "vitest",
    "baseRef": "origin/main",
    "outputDir": ".tautest",
    "score": {
        "strong": 80,
        "mixed": 60
    },
    "stryker": {
        "incremental": false,
        "timeoutMS": 600000,
        "dryRunTimeoutMinutes": 15,
        "concurrency": 2,
        "vitest": { "related": false },
        "vitestConfigFile": "vitest.config.ts",
        "disableTypeChecks": ["!reports/**", "!**/*.html"],
        "userConfig": {
            "ignorePatterns": [
                "scripts/quality-check.ts",
                "scripts/validation-hook.ts",
                "scripts/audit-mock-boundaries.ts",
                "scripts/__tests__/quality-check.test.ts",
                "scripts/__tests__/validation-hook*.test.ts"
            ],
            "env": {
                "STRYKER_ACTIVE": "true",
                "CI": "true"
            }
        }
    },
    "prompt": {
        "style": "opencode"
    }
}
